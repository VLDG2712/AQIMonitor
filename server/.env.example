# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Generate secrets with:  openssl rand -hex 32

# --- Device being polled ---
HEXAIR_DEVICE_URL=http://192.168.2.116:9091/air
HEXAIR_DEVICE_ID=hexair-1
HEXAIR_POLL_INTERVAL=30
HEXAIR_DEVICE_TIMEOUT=5
# Only needed once /air is given auth in the firmware; harmless before then.
HEXAIR_DEVICE_TOKEN=

# --- Database ---
# host.docker.internal reaches the mariadb container via its published port
# on the host gateway (see the note in docker-compose.yml).
HEXAIR_DB_HOST=host.docker.internal
HEXAIR_DB_PORT=3306
HEXAIR_DB_NAME=hexair
HEXAIR_DB_USER=hexair
HEXAIR_DB_PASSWORD=

# --- Read API ---
# Bearer token the Flutter app must present. Service refuses to start without it.
HEXAIR_API_TOKEN=
# Max points returned per query; drives automatic bucket selection.
HEXAIR_MAX_POINTS=600

# --- MQTT / Home Assistant ---
HEXAIR_MQTT_ENABLED=false
# Mosquitto runs on the Pi host, not in Docker, so it is reached via the
# host gateway from inside the container.
HEXAIR_MQTT_HOST=host.docker.internal
HEXAIR_MQTT_PORT=1883
HEXAIR_MQTT_USER=hexair
HEXAIR_MQTT_PASSWORD=
# Must match the discovery prefix configured in Home Assistant's MQTT integration.
HEXAIR_MQTT_DISCOVERY_PREFIX=homeassistant
